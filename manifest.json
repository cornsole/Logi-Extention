{
  "manifest_version": 3,
  "name": "YouTube Horizontal Wheel Seek",
  "version": "1.0.0",
  "description": "Seek YouTube videos with a horizontal mouse wheel.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "action": {
    "default_title": "YouTube Horizontal Wheel Seek",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": [
        "src/content/wheel-normalizer.js",
        "src/content/paused-seeker.js",
        "src/content/settings.js",
        "src/content/youtube-wheel.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
